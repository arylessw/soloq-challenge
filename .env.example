# Copie vers .env pour le dev local
DATABASE_URL="postgresql://user:pass@host/neondb?sslmode=require"
RIOT_API_KEY="rg1_xxxxxxxx"

# URL publique du site (partages Discord, Open Graph) — ton domaine Vercel exact
# Ex. https://soloq-challenge.vercel.app (sans slash final)
NEXT_PUBLIC_SITE_URL="https://soloq-challenge.vercel.app"

 # Publicités latérales (optionnel — pas de popup)
 NEXT_PUBLIC_ADS_ENABLED="true"
 NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-xxxxxxxx"
 NEXT_PUBLIC_ADSENSE_SLOT_LEFT="1234567890"
 NEXT_PUBLIC_ADSENSE_SLOT_RIGHT="0987654321"

# Mot de passe admin (page /admin — toi seul)
# Génère une valeur longue aléatoire, ex. : openssl rand -hex 32
ADMIN_SECRET="change-moi-en-prod"

# Sessions comptes utilisateurs (32+ caractères aléatoires)
SESSION_SECRET="change-moi-en-prod-aussi"

# Webhook Discord (notifications montée de rang, leader LP, duels)
# Créer un webhook dans Paramètres serveur → Intégrations → Webhooks
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
