generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  avatarMime   String?
  avatarData   Bytes?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  players Player[]
}

model Player {
  id              String    @id @default(cuid())
  gameName        String
  tagLine         String
  puuid           String?
  summonerId      String?
  startTier       String
  startDivision   String
  startLp         Int       @default(0)
  currentTier     String?
  currentDivision String?
  currentLp       Int?
  lpGained        Int       @default(0)
  lpLost          Int       @default(0)
  wins            Int?
  losses          Int?
  winsAtStart     Int       @default(0)
  lossesAtStart   Int       @default(0)
  avgKda          Float?
  kdaGames        Int?
  lastKdaSyncedAt DateTime?
  lastGameAt      DateTime?
  streakType      String?
  streakCount     Int       @default(0)
  championStats   Json?
  roleStats       Json?
  inGame          Boolean   @default(false)
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  lpSnapshots LpSnapshot[]
  duelsAsA     Duel[]      @relation("DuelPlayerA")
  duelsAsB     Duel[]      @relation("DuelPlayerB")

  @@unique([gameName, tagLine])
  @@index([userId])
}

model Duel {
  id          String   @id @default(cuid())
  playerAId   String
  playerBId   String
  metric      String   @default("lp")
  startLpNetA Int
  startLpNetB Int
  startWinsA  Int      @default(0)
  startWinsB  Int      @default(0)
  startsAt    DateTime @default(now())
  endsAt      DateTime
  status      String   @default("active")
  winnerId    String?
  createdAt   DateTime @default(now())

  playerA Player @relation("DuelPlayerA", fields: [playerAId], references: [id], onDelete: Cascade)
  playerB Player @relation("DuelPlayerB", fields: [playerBId], references: [id], onDelete: Cascade)

  @@index([status, endsAt])
}

model LpSnapshot {
  id         String   @id @default(cuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  lpNet      Int
  tier       String?
  division   String?
  lp         Int?
  recordedAt DateTime @default(now())

  @@index([playerId, recordedAt])
}
